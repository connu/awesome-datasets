root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Trailing whitespace is meaningful for line breaks in Markdown.
trim_trailing_whitespace = false

[*.csv]
insert_final_newline = true
trim_trailing_whitespace = false
